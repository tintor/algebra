build --action_env=CC=clang
build --action_env=CXX=clang++
build --cxxopt=-std=c++23
build --cxxopt=-Wfatal-errors
build --cxxopt=-DNDEBUG
build --cxxopt=-O3

build --cxxopt=-mfma
build --cxxopt=-mavx2

# Note: -ffast-math must not be used here. It implies -ffinite-math-only, which lets the
# compiler assume no NaN or infinity, so the std::isnan() / std::isinf() guards in
# rational(floating point) are removed and those values silently produce garbage instead of
# throwing. The floating point in this library is only used for seeds and for exact
# conversions, so there is nothing to gain from it either.
